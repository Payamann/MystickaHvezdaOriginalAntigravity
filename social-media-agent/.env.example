# === OPENAI (GPT-6 Luna — generování textů, REQUIRED) ===
OPENAI_API_KEY=your_openai_api_key_here
TEXT_REASONING_EFFORT=medium
TEXT_MAX_OUTPUT_TOKENS=8192

# === GEMINI API (Imagen 3 — generování obrázků) ===
GEMINI_API_KEY=your_gemini_api_key_here

# === META / FACEBOOK ===
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# === FACEBOOK PAGE (volitelné — pro FB posty) ===
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=

# === BUFFER (volitelné — plánování postů) ===
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=

# === IMGBB (hosting obrázků pro Buffer — volitelné) ===
# Zdarma na https://imgbb.com
IMGBB_API_KEY=

# === HUGGING FACE (FLUX.1-schnell — volitelné) ===
# Zdarma na https://huggingface.co/settings/tokens (Read token)
HF_API_TOKEN=

# === ELEVENLABS (Reels voiceover) ===
ELEVENLABS_API_KEY=
# Either set a concrete voice ID, or call reel_factory.py with --voice-name.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Mysticka Hvezda 2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=true

# === NASTAVENÍ ===
LANGUAGE=cs
BRAND_NAME=Mystická Hvězda
WEBSITE_URL=https://www.mystickahvezda.cz

# === COMMENT BOT SAFETY LIMITS ===
# Public replies should be slow, varied and mostly non-promotional.
COMMENT_POLL_INTERVAL=1200
DAILY_REPLY_LIMIT=60
REPLY_DELAY_MIN=180
REPLY_DELAY_MAX=420
MAX_REPLIES_PER_POST=3
MAX_REPLIES_PER_USER_PER_RUN=0
COMMENT_SOFT_PROMO_RATE=10
