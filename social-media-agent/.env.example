# === OPENAI (GPT-6 Luna texty; GPT Image 2.5 Flare obrázky, REQUIRED) ===
OPENAI_API_KEY=your_openai_api_key_here
TEXT_REASONING_EFFORT=medium
TEXT_MAX_OUTPUT_TOKENS=8192

# === META / FACEBOOK ===
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# === FACEBOOK PAGE (volitelné — pro FB posty) ===
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=

# === BUFFER (volitelné — plánování postů) ===
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=

# === IMGBB (hosting obrázků pro Buffer — volitelné) ===
# Zdarma na https://imgbb.com
IMGBB_API_KEY=

# === OPENAI REELS AUDIO (shares OPENAI_API_KEY above) ===
# Realtime WebSocket API, PCM 24 kHz WAV. Not the deprecated audio/speech API.
OPENAI_AUDIO_MODEL=gpt-realtime-2.1-mini
OPENAI_AUDIO_VOICE=marin
# Daily Reel captions: whisper-1 word timestamps, validated against narration.
# --skip-alignment opts into approximate timing without transcription calls.

# === NASTAVENÍ ===
LANGUAGE=cs
BRAND_NAME=Mystická Hvězda
WEBSITE_URL=https://www.mystickahvezda.cz

# === COMMENT BOT SAFETY LIMITS ===
# Public replies should be slow, varied and mostly non-promotional.
COMMENT_POLL_INTERVAL=1200
DAILY_REPLY_LIMIT=60
REPLY_DELAY_MIN=180
REPLY_DELAY_MAX=420
MAX_REPLIES_PER_POST=3
MAX_REPLIES_PER_USER_PER_RUN=0
COMMENT_SOFT_PROMO_RATE=10
